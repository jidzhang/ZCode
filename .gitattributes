# 保持脚本文件 LF 换行，避免 Windows CRLF 导致 shebang 解析失败
*.mjs text eol=lf
*.sh  text eol=lf

# E2E PDF fixture 含规范 xref 尾空格，必须按二进制处理，避免 diff --check 误报。
packages/desktop/test/e2e/fixtures/fs/**/*.pdf binary

# 上游许可原文与生成的声明按字节保存，不能自动转换换行或裁剪空白。
# 原文中的 License / ======= 是 Markdown 标题，不是合并冲突。
THIRD-PARTY-NOTICES.md -text -whitespace conflict-marker-size=32 linguist-generated=true
third-party/upstream/** -text -whitespace
third-party/native-search/licenses/** -text -whitespace
third-party/runtime/*.txt -text -whitespace
docs/knip/docs/LICENSE -text -whitespace
docs/knip/docs/licenses/** -text -whitespace
third-party/inventory.json linguist-generated=true

# Gen UI 运行时的 vendored 资源带 manifest sha256 固定快照，构建期逐文件校验；
# Windows runner 默认 autocrlf=true 会在检出时把 .js/.css 重写成 CRLF，导致
# 哈希失配（v3.15.1-safe.1 首跑 win 挂、mac 过即此差异）。按字节精确检出。
apps/zcode-cli/packages/visualize-plugin/skills/visualize/assets/** -text
